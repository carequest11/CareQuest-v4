# Copy these into Vercel -> Project Settings -> Environment Variables.
# Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

DAILY_API_KEY=

# Signing secret for the Daily webhook that points at /api/daily-webhook.
# Generate it yourself (`openssl rand -base64 32`), set it here, deploy,
# and only then create the webhook passing the same value as "hmac" —
# Daily's validation POST is signed, so a secret Daily generates for you
# can't be verified in time. Without this set, that endpoint rejects
# every real event and no recordings get logged.
DAILY_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it
# as a Bearer token on the scheduled /api/purge-recordings run, and it's
# what stops anyone else from triggering a purge.
CRON_SECRET=

# Web Push (staff sign-up alerts, /api/send-signup-push). Generate a
# keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a "mailto:" address or https URL — it's how a
# push service can contact you if your server misbehaves. The public
# key is not secret; it's also pasted into member.html's client-side
# subscribe code, so if you regenerate the keypair, update both places.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any long random string (e.g. `openssl rand -hex 32`). Store the same
# value in Supabase Vault as "signup_push_webhook_secret" (see the
# "Sign-up push triggers" section of supabase-schema.sql); the triggers
# send it as the "x-webhook-secret" header when calling
# /api/send-signup-push. Required — the endpoint refuses every request
# while it's unset, so nobody can spam staff devices with fake alerts.
SIGNUP_PUSH_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`) — a different
# value from the two other webhook secrets. Store the same value in
# Supabase Vault as "signup_email_webhook_secret" (see the "Sign-up
# email notifications" section of supabase-schema.sql); the triggers
# send it as "x-webhook-secret" when calling /api/send-signup-email,
# which emails each new sign-up's details to care1quest@gmail.com
# through Resend (reusing RESEND_API_KEY and MESSAGE_EMAIL_FROM below).
# Required — the endpoint refuses every request while it's unset. Not
# related to the SIGNUP_EMAIL_USER/APP_PASSWORD Gmail settings below.
SIGNUP_EMAIL_WEBHOOK_SECRET=

# Optional email copy of each sign-up alert (/api/send-signup-push),
# sent through Gmail SMTP. SIGNUP_EMAIL_USER is the Gmail address it
# sends from; SIGNUP_EMAIL_APP_PASSWORD is a 16-character Google app
# password for that account (myaccount.google.com/apppasswords — needs
# 2-Step Verification on), not the normal account password.
# SIGNUP_EMAIL_TO defaults to SIGNUP_EMAIL_USER. Emails are skipped
# while either of the first two is unset.
SIGNUP_EMAIL_USER=
SIGNUP_EMAIL_APP_PASSWORD=
SIGNUP_EMAIL_TO=

# Message notification emails (/api/send-message-email), sent through
# Resend. RESEND_API_KEY comes from resend.com -> API Keys (sending
# access is enough). MESSAGE_EMAIL_FROM must be on a domain verified
# in Resend; it defaults to "CareQuest <notifications@carequest.info>".
RESEND_API_KEY=
MESSAGE_EMAIL_FROM=

# Any long random string (e.g. `openssl rand -hex 32`). Store the same
# value in Supabase Vault as "message_email_webhook_secret" (see the
# "Message email notifications" section of supabase-schema.sql); the
# trigger on messages sends it as "x-webhook-secret". Required — the
# endpoint refuses every request while it's unset.
MESSAGE_EMAIL_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`). Signs the
# unsubscribe link in every message email so it works without logging
# in but can't be forged for someone else's account. Changing it
# breaks the links in emails already sent.
UNSUBSCRIBE_SECRET=
