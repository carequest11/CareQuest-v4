# Copy these into Vercel -> Project Settings -> Environment Variables.
# Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

DAILY_API_KEY=

# The "hmac" value Daily returns when you create the webhook that points
# at /api/daily-webhook. Without it that endpoint rejects every request.
DAILY_WEBHOOK_SECRET=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel sends it
# as a Bearer token on the scheduled /api/purge-recordings run, and it's
# what stops anyone else from triggering a purge.
CRON_SECRET=
